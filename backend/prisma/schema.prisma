// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid())
  firstName       String
  lastName        String
  email           String         @unique
  phone           String?        @unique
  password        String
  role            UserRole       @default(BUYER)
  status          UserStatus     @default(ACTIVE)
  isEmailVerified Boolean        @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relation to refresh tokens (cascade delete on user removal)
  refreshTokens   RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique          // BUG FIX: must be unique so lookups are fast
                                       // and duplicate tokens are impossible
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  // BUG FIX: The original had NO @relation directive at all.
  // Prisma requires an explicit relation; without it the FK is never
  // enforced and querying user.refreshTokens crashes at runtime.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────
// Legacy test models – keep if still needed, remove in production
// ─────────────────────────────────────────────────────────────────
model try_prisma {
  try_id     Int       @id @default(autoincrement())
  name       String?   @db.VarChar(50)
  reason     String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model proveAppIsConnected {
  connect_id  Int       @id @default(autoincrement())
  is_writting Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}